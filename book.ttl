@prefix bk: <http://example.org/groupA-wizard-of-oz#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Classes
bk:Character a rdfs:Class ;
    rdfs:label "Character"@en .

bk:Chapter a rdfs:Class ;
    rdfs:label "Chapter"@en .

bk:Dog a rdfs:Class ;
    rdfs:subClassOf schema:Animal ;
    rdfs:label "Dog"@en .

bk:Witch a rdfs:Class ;
    rdfs:subClassOf bk:Character ;
    rdfs:label "Witch"@en .

bk:Wizzard a rdfs:Class ;
    rdfs:subClassOf bk:Character ;
    rdfs:label "Wizzard"@en .

bk:Item a rdfs:Class ;
    rdfs:label "Magical item"@en .

# Properties
bk:appearsIn a rdf:Property ;
    rdfs:domain bk:Character;
    rdfs:range bk:Chapter ;
    rdfs:label "appears in"@en ;
    rdfs:comment "Links a character to a chapter in which they appear."@en .

bk:livesIn a rdf:Property ;
    rdfs:domain bk:Character ;
    rdfs:range schema:Place ;
    rdfs:label "lives in"@en .

bk:chapterNumber a rdf:Property ;
    rdfs:domain bk:Chapter ;
    rdfs:range xsd:integer ;
    rdfs:label "chapter number"@en .

bk:Farmer a schema:Occupation ;
    rdfs:label "Farmer"@en .

bk:possesses a rdf:Property ;
    rdfs:domain bk:Character ;
    rdfs:range bk:Item ;
    rdfs:label "possesses"@en .

bk:rules a rdf:Property ;
    rdfs:domain bk:Character ;
    rdfs:range schema:Place ;
    rdfs:label "rules"@en .

bk:alliedTo a rdf:Property ;
    rdfs:domain bk:Character ;
    rdfs:range schema:Character ;
    rdfs:label "Allied with"@en .

bk:enemiesWith a rdf:Property ;
    rdfs:domain bk:Character ;
    rdfs:range schema:Character ;
    rdfs:label "enemiesWith with"@en .


# Author
bk:LFrankBaum a foaf:Person ;
    foaf:name "L. Frank Baum" ;
    owl:sameAs <https://www.wikidata.org/wiki/Q207544>.
    
# Metadata do Livro
bk:TheWonderfulWizardOfOz a schema:Book ;
    dcterms:title "The Wonderful Wizard of Oz" ;
    dcterms:creator bk:LFrankBaum ;
    schema:datePublished "1900"^^xsd:gYear .
    
# Chapter I
bk:ChapterI a bk:Chapter ;
    dcterms:title "The Cyclone" ;
    bk:chapterNumber "1"^^xsd:integer ;
    dcterms:isPartOf bk:TheWonderfulWizardOfOz .

# Chapter II
bk:ChapterII a bk:Chapter ;
    dcterms:title "The Council with the Munchkins" ;
    bk:chapterNumber "2"^^xsd:integer ;
    dcterms:isPartOf bk:TheWonderfulWizardOfOz .

# Characters
bk:Dorothy a foaf:Person ;
			a bk:Character ;
 			foaf:name "Dorothy" ;
 			bk:appearsIn bk:ChapterI ;
            bk:appearsIn bk:ChapterII ;
 			schema:relatedTo bk:UncleHenry;
    		schema:relatedTo bk:AuntEm;
      		bk:livesIn bk:Kansas;
            schema:owns bk:Toto;
        	rdfs:seeAlso <https://www.wikidata.org/wiki/Q2583524>.

bk:UncleHenry a foaf:Person ;
			a bk:Character ;
			schema:hasOccupation bk:Farmer ;
 			foaf:name "Henry" ;
 			bk:appearsIn bk:ChapterI ;
    		schema:relatedTo bk:AuntEm;
      		bk:livesIn bk:Kansas.

bk:AuntEm a foaf:Person ;
			a bk:Character ; 
 			foaf:name "Em" ;
 			bk:appearsIn bk:ChapterI ;
      		bk:livesIn bk:Kansas.

bk:Toto a bk:Dog ;
			a bk:Character ;
    		rdfs:label "Toto" ;
    		bk:appearsIn bk:ChapterI ;
            bk:appearsIn bk:ChapterII ;
			bk:livesIn bk:Kansas.

bk:Kansas a schema:Place ;
    		rdfs:label "Kansas" ;
    		owl:sameAs <https://www.wikidata.org/wiki/Q1558> .

bk:WitchOfTheNorth a bk:Witch ;
    bk:appearsIn bk:ChapterII ;
	bk:enemiesWith bk:WitchOfTheWest;
	bk:enemiesWith bk:WitchOfTheEast;
	bk:alliedTo bk:WitchOfTheSouth .
	
bk:WitchOfTheSouth a bk:Witch ;
	bk:enemiesWith bk:WitchOfTheWest;
	bk:enemiesWith bk:WitchOfTheEast;
	bk:alliedTo bk:WitchOfTheNorth.

bk:WitchOfTheWest a bk:Witch ;
	bk:enemiesWith bk:WitchOfTheSouth;
	bk:enemiesWith bk:WitchOfTheNorth;
	bk:alliedTo bk:WichOfTheEast.

bk:WitchOfTheEast a bk:Witch ;
    bk:appearsIn bk:ChapterII ;
    bk:livesIn bk:MunchkinCountry ;
    bk:rules bk:MunchkinCountry ;
    bk:possesses bk:SilverShoes ;
	bk:enemiesWith bk:WitchOfTheSouth;
	bk:enemiesWith bk:WitchOfTheNorth;
	bk:alliedTo bk:WichOfTheWest.

bk:WizzardOfOz a bk:Wizzard.

bk:MunchkinCountry a schema:Place ;

bk:SilverShoes a bk:Item ;
    rdfs:comment "Magic shoes taken from the Witch of the East."@en .
